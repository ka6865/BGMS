# BGMS 환경 변수 목록 (이름과 용도만 적는다. 실제 값은 .env.local 과 Vercel·GitHub Secrets 에만 둔다.)
# NEXT_PUBLIC_ 로 시작하는 값은 브라우저 번들에 포함된다. 비밀 값을 넣지 않는다.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버·운영 스크립트 전용. 클라이언트 코드와 로그에 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
# 일부 운영 스크립트가 NEXT_PUBLIC_SUPABASE_URL 대신 읽는다.
SUPABASE_URL=
# 관리자 대시보드 DB 용량 경고 기준(바이트)
SUPABASE_DATABASE_LIMIT_BYTES=

# 사이트 주소
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
APP_URL=

# PUBG API
PUBG_API_KEY=
PUBG_ERROR_FINGERPRINT_SECRET=
PUBG_MATCH_COLLECTION_SECRET=
PUBG_SCRAPER_INTERNAL_TOKEN=
PUBG_META_PATCH_VERSION=
PUBG_META_PATCH_STARTED_AT=
PUBG_ENCOUNTER_CACHE_ENABLED=
PUBG_PERFORMANCE_ENABLED=

# Cloudflare R2
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# 보존 정리 복구 아티팩트 암호화 키(운영 워크플로 전용)
R2_RECOVERY_ARCHIVE_KEY=

# AI
GOOGLE_GEMINI_API_KEY=
COMMUNITY_AGENT_MODEL=
TAVILY_API_KEY=

# 정기 작업·관리자 인증 (Authorization: Bearer)
CRON_SECRET=
ADMIN_AGENT_CRON_SECRET=
ADMIN_REVALIDATE_TOKEN=

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
DISCORD_WEBHOOK_URL=
DISCORD_SUPPORT_WEBHOOK_URL=
DISCORD_PATCH_NOTES_WEBHOOK_URL=
DISCORD_COMMUNITY_WEBHOOK_URL=
DISCORD_COMMUNITY_REVIEW_WEBHOOK_URL=
DISCORD_COMMUNITY_REVIEW_CHANNEL_ID=
DISCORD_COMMUNITY_REVIEW_APPLICATION_ID=
DISCORD_COMMUNITY_REVIEW_PUBLIC_KEY=
DISCORD_COMMUNITY_APPROVER_ID=

# 분석·광고
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ANALYTICS_ALLOWED_HOSTS=
NEXT_PUBLIC_ANALYTICS_MIRROR_DISABLED=
NEXT_PUBLIC_ANALYTICS_MIRROR_LOCAL=
ANALYTICS_ACCEPT_LOCAL=
NEXT_PUBLIC_ENABLE_SPEED_INSIGHTS=

# 데이터 품질 감사
DATA_QUALITY_AUDIT_MAX_ROWS=
DATA_QUALITY_AUDIT_RECENT_DAYS=
DATA_QUALITY_APPROVAL_TARGET_LIMIT=

# Vercel (배포 환경이 자동으로 넣는 값은 로컬에서 비워 둔다)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_AUTOMATION_BYPASS_SECRET=

# 로컬 개발
BGMS_TAILSCALE_DEV_HOST=
