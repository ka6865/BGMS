#!/bin/sh
# push 전에 CI 첫 단계(npm run verify:core)를 실행한다.
# 건너뛰기: SKIP_PRE_PUSH=1 git push ... (CI는 그대로 검증한다)

if [ -n "$SKIP_PRE_PUSH" ]; then
  echo "[pre-push] SKIP_PRE_PUSH 설정으로 검증을 건너뜁니다."
  exit 0
fi

# 브랜치 삭제 push만 있으면 검증할 코드가 없다.
has_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;;
    *) has_update=1 ;;
  esac
done
[ "$has_update" -eq 0 ] && exit 0

PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
cd "$(git rev-parse --show-toplevel)" || exit 1

if [ ! -d node_modules ]; then
  echo "[pre-push] node_modules가 없어 검증할 수 없습니다. npm install 후 다시 push하세요."
  exit 1
fi

echo "[pre-push] npm run verify:core 실행 중..."
npm run verify:core || {
  echo "[pre-push] verify:core 실패로 push를 중단합니다."
  exit 1
}
